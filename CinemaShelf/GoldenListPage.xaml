<?xml version="1.0" encoding="utf-8"?>
<ContentPage
    x:Name="RootGoldenPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:CinemaShelf"
    xmlns:ios="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Microsoft.Maui.Controls"
    x:Class="CinemaShelf.GoldenListPage"
    Shell.NavBarIsVisible="False"
    ios:Page.UseSafeArea="True"
    BackgroundColor="#0D0B1A">
    <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,*,Auto,Auto" Padding="20,5" RowSpacing="5">
        <Grid.GestureRecognizers>
            <TapGestureRecognizer Tapped="OnBackgroundTapped" />
        </Grid.GestureRecognizers>
        <!-- Home button -->
        <Border
            Grid.Row="0"
            Stroke="Transparent"
            StrokeThickness="1.5"
            StrokeShape="RoundRectangle 8"
            BackgroundColor="#6C3CE1"
            Padding="8,0"
            HeightRequest="{OnPlatform Android=38, Default=28}"
            HorizontalOptions="Fill">
            <Border.Shadow>
                <Shadow Brush="#6C3CE1" Offset="0,0" Radius="10" Opacity="0.6" />
            </Border.Shadow>
            <Border.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnHomeClicked" />
            </Border.GestureRecognizers>
            <Label Text="✦  H O M E  ✦"
                   TextColor="White"
                   FontSize="12"
                   FontAttributes="Bold,Italic"
                   HorizontalOptions="Center"
                   VerticalOptions="Center"
                   CharacterSpacing="1" />
        </Border>
        <Label Grid.Row="1" Text="&#x2605; Golden List"
               Margin="0,20,0,0"
               FontSize="20"
               FontAttributes="Bold"
               TextColor="Gold"
               HorizontalOptions="Center" />
        <Border Grid.Row="2"
                Stroke="#FFD700"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 8"
                BackgroundColor="#1A1400"
                Padding="6,0,0,0"
                Margin="0,0,0,20"
                HeightRequest="{OnPlatform Android=40, Default=28}">
            <Grid ColumnDefinitions="*,Auto">
                <Entry Grid.Column="0"
                    x:Name="SearchBar"
                    Placeholder="Search in your golden list..."
                    ClearButtonVisibility="WhileEditing"
                    PlaceholderColor="#E0AAFF"
                    TextColor="#E0AAFF"
                    BackgroundColor="Transparent"
                    FontSize="16"
                    TextChanged="OnSearchTextChanged"
                    VerticalOptions="Center" />
                <Button Grid.Column="1"
                    x:Name="SearchButton"
                    Text="⌕"
                    Clicked="OnSearchButtonClicked"
                    BackgroundColor="#B8860B"
                    TextColor="White"
                    FontSize="20"
                    WidthRequest="{OnPlatform Android=60, Default=80}"
                    HeightRequest="{OnPlatform Android=40, Default=28}"
                    MinimumHeightRequest="0"
                    CornerRadius="8"
                    BorderColor="#FFD700"
                    BorderWidth="1.5"
                    Margin="0"
                    Padding="0"
                    VerticalOptions="Center"
                    HorizontalOptions="End">
                    <Button.Shadow>
                        <Shadow Brush="#FFD700" Offset="0,0" Radius="12" Opacity="0.7" />
                    </Button.Shadow>
                </Button>
            </Grid>
        </Border>
        <!-- Row 3: Ad banner under the search field -->
        <local:AdBannerView Grid.Row="3" OverrideAdUnitId="ca-app-pub-3940256099942544/6300978111" Margin="0,-2,0,0" />

        <Grid Grid.Row="4" ColumnDefinitions="*,Auto" ColumnSpacing="3">
            <HorizontalStackLayout Grid.Column="0" Spacing="3" HorizontalOptions="Start">
                <Button
                    x:Name="SortButton"
                    Text="▼ Sort"
                    Clicked="OnSortClicked"
                    BackgroundColor="#1A1400"
                    TextColor="#FFD700"
                    FontAttributes="Bold"
                    FontSize="11"
                    CornerRadius="6"
                    BorderColor="#FFD700"
                    BorderWidth="1"
                    Padding="6,0"
                    HeightRequest="26"
                    MinimumHeightRequest="0" />
                <Grid>
                    <Button
                        x:Name="FormatButton"
                        Text="▼ Format"
                        Clicked="OnFormatClicked"
                        BackgroundColor="#1A1400"
                        TextColor="#FFD700"
                        FontAttributes="Bold"
                        FontSize="11"
                        CornerRadius="6"
                        BorderColor="#FFD700"
                        BorderWidth="1"
                        Padding="6,0"
                        HeightRequest="26"
                        MinimumHeightRequest="0" />
                </Grid>
                <Button
                    x:Name="ShareButton"
                    Text="&#x21E7; Share"
                    Clicked="OnShareClicked"
                    BackgroundColor="#1A1400"
                    TextColor="#FFD700"
                    FontAttributes="Bold"
                    FontSize="11"
                    CornerRadius="6"
                    BorderColor="#FFD700"
                    BorderWidth="1"
                    Padding="6,0"
                    HeightRequest="26"
                    MinimumHeightRequest="0" />
            </HorizontalStackLayout>
            <Button
                Grid.Column="1"
                x:Name="ClearAllButton"
                Text="&#x2715; Clear All"
                Clicked="OnClearAllClicked"
                BackgroundColor="#1A0A2E"
                TextColor="#FF4444"
                FontAttributes="Bold"
                FontSize="11"
                CornerRadius="6"
                BorderColor="#FF4444"
                BorderWidth="1.5"
                Padding="6,0"
                HeightRequest="26"
                MinimumHeightRequest="0"
                WidthRequest="{OnPlatform iOS=70, Default=85}"
                HorizontalOptions="End" />
        </Grid>
        <Grid Grid.Row="5" ColumnDefinitions="*,Auto">
            <Border
                Stroke="#FFD700"
                StrokeThickness="2"
                StrokeShape="RoundRectangle 12"
                BackgroundColor="#664D3B00"
                Padding="10"
                MinimumHeightRequest="200">
                <Border.Shadow>
                    <Shadow Brush="#FFD700"
                            Offset="0,0"
                            Radius="15"
                            Opacity="0.7" />
                </Border.Shadow>
                <Grid RowDefinitions="Auto,*">
                    <Label Grid.RowSpan="2" x:Name="EmptyLabel"
                           Text="&#x2605; Your golden list is empty"
                           TextColor="#BFA530"
                           FontSize="18"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"
                           IsVisible="True" />
                    <Grid Grid.Row="0" x:Name="SelectAllRow" IsVisible="False" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,3">
                        <Border Padding="4,2" StrokeShape="RoundRectangle 8" Stroke="#FFD700" StrokeThickness="1" BackgroundColor="#1A1400" HeightRequest="{OnPlatform Android=40, Default=28}" HorizontalOptions="Start">
                            <HorizontalStackLayout Spacing="0">
                                <CheckBox x:Name="SelectAllCheckBox" Color="#FFD700" VerticalOptions="Center" CheckedChanged="OnSelectAllCheckChanged" />
                                <Label Text="All" TextColor="#FFD700" FontSize="16" FontAttributes="Bold" VerticalOptions="Center" Margin="0,0,8,0" />
                            </HorizontalStackLayout>
                        </Border>
                        <Button Grid.Column="2" x:Name="OkButton" Text="OK" Clicked="OnOkClicked" BackgroundColor="#B8860B" TextColor="White" FontAttributes="Bold" FontSize="14" CornerRadius="8" BorderColor="#FFD700" BorderWidth="1.5" Padding="16,2" HeightRequest="{OnPlatform Android=40, Default=28}" MinimumHeightRequest="0" HorizontalOptions="End" VerticalOptions="Center">
                            <Button.Shadow>
                                <Shadow Brush="#FFD700" Offset="0,0" Radius="12" Opacity="0.7" />
                            </Button.Shadow>
                        </Button>
                    </Grid>
                    <CollectionView Grid.Row="1"
                        x:Name="GoldenCollectionView"
                        ItemsSource="{Binding Movies}">
                        <CollectionView.Header>
                            <local:NativeAdCard
                                AdUnitId="ca-app-pub-3940256099942544/2247696110"
                                HeightRequest="140"
                                Margin="0,5" />
                        </CollectionView.Header>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="local:Movie">
                                <Border
                                    Margin="0,5"
                                    Padding="10"
                                    StrokeShape="RoundRectangle 8"
                                    Stroke="#FFD700"
                                    StrokeThickness="2"
                                    BackgroundColor="#1A1200">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="BackgroundColor" Value="#1A1200" />
                                            <Style.Triggers>
                                                <DataTrigger TargetType="Border" Binding="{Binding IsInBothLists}" Value="True">
                                                    <Setter Property="BackgroundColor" Value="#2A1A33" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Border.Shadow>
                                        <Shadow Brush="#FFD700" Offset="0,0" Radius="12" Opacity="0.7" />
                                    </Border.Shadow>
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnMovieTapped" CommandParameter="{Binding .}" />
                                    </Border.GestureRecognizers>
                                    <Grid ColumnDefinitions="48,Auto,*,Auto" ColumnSpacing="3">
                                        <CheckBox Grid.Column="0"
                                              IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                              Color="#FFD700"
                                              VerticalOptions="Center"
                                              CheckedChanged="OnCheckBoxCheckedChanged"
                                              IsVisible="{Binding BindingContext.ShowSelection, Source={x:Reference RootGoldenPage}}" />
                                        <Border Grid.Column="0"
                                                BackgroundColor="Transparent"
                                                StrokeThickness="0"
                                                WidthRequest="46"
                                                HeightRequest="40"
                                                Margin="0,0,0,0"
                                                Padding="0"
                                                IsVisible="{Binding CanRestoreToMain}">
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer Tapped="RestoreToMain_Clicked" CommandParameter="{Binding Id}" />
                                            </Border.GestureRecognizers>
                                            <Label Text="+"
                                                   TextColor="#FFD700"
                                                   FontSize="20"
                                                   HorizontalOptions="Center"
                                                   VerticalOptions="Center" />
                                        </Border>
                                        <Image Grid.Column="1"
                                               Source="{Binding PosterUrl}"
                                               HeightRequest="70"
                                               WidthRequest="47"
                                               Aspect="AspectFill"
                                               Margin="0,0,5,0" />
                                        <StackLayout Grid.Column="2" VerticalOptions="Center" Spacing="2">
                                            <Label
                                                Text="{Binding Title}"
                                                FontSize="16"
                                                FontAttributes="Bold"
                                                TextColor="White"
                                                LineBreakMode="TailTruncation" />
                                            <HorizontalStackLayout Spacing="5">
                                                <Label
                                                    Text="{Binding ContentTypeIcon}"
                                                    FontSize="11"
                                                    TextColor="White"
                                                    VerticalOptions="Center" />
                                                <Label
                                                    Text="{Binding Year}"
                                                    FontSize="13"
                                                    TextColor="#FFD700" />
                                            </HorizontalStackLayout>
                                            <Label
                                                Text="{Binding Rating, StringFormat='★ {0:F1}'}"
                                                FontSize="13"
                                                TextColor="#FFEEBB" />
                                            <Label
                                                Text="{Binding Description}"
                                                FontSize="10"
                                                TextColor="#BFA530"
                                                LineBreakMode="WordWrap" />
                                        </StackLayout>
                                        <Button Grid.Column="3"
                                                Text="✕"
                                                BackgroundColor="Transparent"
                                                TextColor="Red"
                                                FontSize="20"
                                                WidthRequest="30"
                                                HeightRequest="40"
                                                Padding="0"
                                                Clicked="RemoveFromGolden_Clicked"
                                                CommandParameter="{Binding Id}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                    <Grid Grid.RowSpan="2" x:Name="EmptyPopup" IsVisible="False" BackgroundColor="#BB0D0B1A" Padding="0" VerticalOptions="FillAndExpand" HorizontalOptions="FillAndExpand" ZIndex="10">
                        <Border StrokeShape="RoundRectangle 12" Stroke="#FFD700" StrokeThickness="1.5" BackgroundColor="#EE1A1400" Padding="25,20" HorizontalOptions="Center" VerticalOptions="Center" MaximumWidthRequest="320">
                            <Border.Shadow>
                                <Shadow Brush="#FFD700" Offset="0,0" Radius="20" Opacity="0.7" />
                            </Border.Shadow>
                            <VerticalStackLayout HorizontalOptions="Center" Spacing="10">
                                <Label Text="Golden list is empty!"
                                       TextColor="#FFD700"
                                       FontSize="18"
                                       FontAttributes="Bold,Italic"
                                       HorizontalOptions="Center"
                                       HorizontalTextAlignment="Center"
                                       CharacterSpacing="1">
                                    <Label.Shadow>
                                        <Shadow Brush="#FFD700" Offset="0,0" Radius="15" Opacity="0.8" />
                                    </Label.Shadow>
                                </Label>
                            </VerticalStackLayout>
                        </Border>
                    </Grid>
                    <Grid Grid.RowSpan="2" x:Name="InfoPopup" IsVisible="False" BackgroundColor="#BB0D0B1A" Padding="0" VerticalOptions="FillAndExpand" HorizontalOptions="FillAndExpand" ZIndex="12">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnInfoPopupDismissed" />
                        </Grid.GestureRecognizers>
                        <Border StrokeShape="RoundRectangle 12" Stroke="#FFD700" StrokeThickness="1.5" BackgroundColor="#EE1A1400" Padding="25,20" HorizontalOptions="Center" VerticalOptions="Center" MaximumWidthRequest="320">
                            <Border.Shadow>
                                <Shadow Brush="#FFD700" Offset="0,0" Radius="20" Opacity="0.7" />
                            </Border.Shadow>
                            <VerticalStackLayout HorizontalOptions="Center" Spacing="10">
                                <Label x:Name="InfoPopupText"
                                       Text=""
                                       TextColor="#FFD700"
                                       FontSize="16"
                                       FontAttributes="Bold,Italic"
                                       HorizontalOptions="Center"
                                       HorizontalTextAlignment="Center"
                                       CharacterSpacing="1">
                                    <Label.Shadow>
                                        <Shadow Brush="#FFD700" Offset="0,0" Radius="15" Opacity="0.8" />
                                    </Label.Shadow>
                                </Label>
                                <Label Text="tap anywhere to dismiss"
                                       TextColor="#BFA530"
                                       FontSize="11"
                                       FontAttributes="Italic"
                                       HorizontalOptions="Center"
                                       Margin="0,5,0,0" />
                            </VerticalStackLayout>
                        </Border>
                    </Grid>
                    <Grid Grid.RowSpan="2" x:Name="DeleteGoldenPopup" IsVisible="False" BackgroundColor="#BB0D0B1A" Padding="30" VerticalOptions="FillAndExpand" HorizontalOptions="FillAndExpand" ZIndex="13">
                        <VerticalStackLayout x:Name="DeleteGoldenPopupContent" HorizontalOptions="Center" VerticalOptions="Center" Spacing="15">
                            <Label Text="✕"
                                   FontSize="52"
                                   TextColor="#FF4444"
                                   HorizontalOptions="Center" />
                            <Label x:Name="DeleteGoldenPopupTitle"
                                   Text="Delete this movie?"
                                   TextColor="#FFD700"
                                   FontSize="20"
                                   FontAttributes="Bold,Italic"
                                   HorizontalOptions="Center"
                                   HorizontalTextAlignment="Center"
                                   CharacterSpacing="1" />
                            <Label x:Name="DeleteGoldenPopupSubtitle"
                                   Text="This action cannot be undone."
                                   TextColor="#BFA530"
                                   FontSize="14"
                                   HorizontalOptions="Center"
                                   HorizontalTextAlignment="Center" />
                            <HorizontalStackLayout Spacing="12" HorizontalOptions="Center" Margin="0,10,0,0">
                                <Button Text="Cancel" Clicked="OnDeleteGoldenCancel" BackgroundColor="#1A1400" TextColor="#FFD700" FontAttributes="Bold" FontSize="14" CornerRadius="8" BorderColor="#FFD700" BorderWidth="1" Padding="20,6" HeightRequest="32" MinimumHeightRequest="0" />
                                <Button Text="Delete" Clicked="OnDeleteGoldenConfirm" BackgroundColor="#FF4444" TextColor="White" FontAttributes="Bold" FontSize="14" CornerRadius="8" Padding="20,6" HeightRequest="32" MinimumHeightRequest="0" />
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </Grid>
                    <Grid Grid.RowSpan="2" x:Name="ClearAllPopup" IsVisible="False" BackgroundColor="#BB0D0B1A" Padding="30" VerticalOptions="FillAndExpand" HorizontalOptions="FillAndExpand" ZIndex="11">
                        <VerticalStackLayout x:Name="ClearAllPopupContent" HorizontalOptions="Center" VerticalOptions="Center" Spacing="15">
                            <Label Text="✕"
                                   FontSize="52"
                                   TextColor="#FF4444"
                                   HorizontalOptions="Center" />
                            <Label Text="Delete all from the golden list?"
                                   TextColor="#FFD700"
                                   FontSize="20"
                                   FontAttributes="Bold,Italic"
                                   HorizontalOptions="Center"
                                   HorizontalTextAlignment="Center"
                                   CharacterSpacing="1" />
                            <Label Text="This action cannot be undone."
                                   TextColor="#BFA530"
                                   FontSize="14"
                                   HorizontalOptions="Center"
                                   HorizontalTextAlignment="Center" />
                            <HorizontalStackLayout Spacing="12" HorizontalOptions="Center" Margin="0,10,0,0">
                                <Button Text="Cancel" Clicked="OnClearAllCancel" BackgroundColor="#1A1400" TextColor="#FFD700" FontAttributes="Bold" FontSize="14" CornerRadius="8" BorderColor="#FFD700" BorderWidth="1" Padding="20,6" HeightRequest="32" MinimumHeightRequest="0" />
                                <Button Text="Delete" Clicked="OnClearAllConfirm" BackgroundColor="#FF4444" TextColor="White" FontAttributes="Bold" FontSize="14" CornerRadius="8" Padding="20,6" HeightRequest="32" MinimumHeightRequest="0" />
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </Grid>
                </Grid>
            </Border>
            <!-- Format dropdown overlay -->
            <Border
                x:Name="FormatDropdown"
                IsVisible="False"
                Stroke="#FFD700"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 8"
                BackgroundColor="#1A1400"
                Padding="0"
                VerticalOptions="Start"
                HorizontalOptions="Start"
                Margin="50,0,0,0"
                ZIndex="200">
                <VerticalStackLayout Spacing="0">
                    <Grid HeightRequest="{OnPlatform iOS=44, Default=35}">
                        <BoxView x:Name="FormatAllBg" Color="#1A1400" HorizontalOptions="Fill" VerticalOptions="Fill" />
                        <Label x:Name="FormatAllLabel" Text="✦ All" TextColor="#FFD700" FontSize="16" VerticalOptions="Center" Padding="10,0" />
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnFormatItemClicked" CommandParameter="All" />
                        </Grid.GestureRecognizers>
                    </Grid>
                    <BoxView HeightRequest="1" Color="#FFD700" Opacity="0.3" />
                    <Grid HeightRequest="{OnPlatform iOS=44, Default=35}">
                        <BoxView x:Name="FormatMoviesBg" Color="#1A1400" HorizontalOptions="Fill" VerticalOptions="Fill" />
                        <Label x:Name="FormatMoviesLabel" Text="▷ Movies" TextColor="#FFD700" FontSize="16" VerticalOptions="Center" Padding="10,0" />
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnFormatItemClicked" CommandParameter="Movies" />
                        </Grid.GestureRecognizers>
                    </Grid>
                    <BoxView HeightRequest="1" Color="#FFD700" Opacity="0.3" />
                    <Grid HeightRequest="{OnPlatform iOS=44, Default=35}">
                        <BoxView x:Name="FormatSeriesBg" Color="#1A1400" HorizontalOptions="Fill" VerticalOptions="Fill" />
                        <Label x:Name="FormatSeriesLabel" Text="■ Series" TextColor="#FFD700" FontSize="16" VerticalOptions="Center" Padding="10,0" />
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnFormatItemClicked" CommandParameter="Series" />
                        </Grid.GestureRecognizers>
                    </Grid>
                </VerticalStackLayout>
            </Border>
            <!-- Sort dropdown overlay -->
            <Border
                x:Name="SortDropdown"
                IsVisible="False"
                Stroke="#FFD700"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 8"
                BackgroundColor="#1A1400"
                Padding="0"
                VerticalOptions="Start"
                HorizontalOptions="Start"
                Margin="0,0,0,0"
                ZIndex="201">
                <VerticalStackLayout Spacing="0">
                    <Grid HeightRequest="{OnPlatform iOS=44, Default=35}">
                        <BoxView x:Name="SortByNameBg" Color="#1A1400" HorizontalOptions="Fill" VerticalOptions="Fill" />
                        <Label x:Name="SortByNameLabel" Text="A → Z" TextColor="#FFD700" FontSize="16" VerticalOptions="Center" Padding="10,0" />
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnSortByNameTapped" />
                        </Grid.GestureRecognizers>
                    </Grid>
                    <BoxView HeightRequest="1" Color="#FFD700" Opacity="0.3" />
                    <Grid HeightRequest="{OnPlatform iOS=44, Default=35}">
                        <BoxView x:Name="SortByDateBg" Color="#1A1400" HorizontalOptions="Fill" VerticalOptions="Fill" />
                        <Label x:Name="SortByDateLabel" Text="New → Old" TextColor="#FFD700" FontSize="16" VerticalOptions="Center" Padding="10,0" />
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnSortByDateTapped" />
                        </Grid.GestureRecognizers>
                    </Grid>
                </VerticalStackLayout>
            </Border>
        </Grid>
        <Grid x:Name="FirstSearchOverlay" IsVisible="False" BackgroundColor="#1A1200" Padding="0" VerticalOptions="FillAndExpand" HorizontalOptions="FillAndExpand" ZIndex="20">
            <Label Text="You can check the details of the Movie/Series!"
                   TextColor="#E0AAFF"
                   FontSize="22"
                   FontAttributes="Bold,Italic"
                   HorizontalOptions="Center"
                   VerticalOptions="Center"
                   Padding="30,20"
                   Margin="0"
                   HorizontalTextAlignment="Center"
                   VerticalTextAlignment="Center" />
        </Grid>
        <!-- Ad Banner -->
        <local:AdBannerView Grid.Row="6" OverrideAdUnitId="ca-app-pub-3940256099942544/6300978111" Margin="0,-5,0,0" />

        <!-- Row 7: second full-width banner, stacked under the first one -->
        <local:AdBannerView Grid.Row="7" OverrideAdUnitId="ca-app-pub-3940256099942544/6300978111" Margin="0,-2,0,0" />
    </Grid>
</ContentPage>
