<?xml version="1.0" encoding="utf-8"?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="CinemaShelf.SplashPage"
    BackgroundColor="#0D0B1A"
    NavigationPage.HasNavigationBar="False"
    Shell.NavBarIsVisible="False">
    <Grid VerticalOptions="Fill" HorizontalOptions="Fill">
        <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center"
                             Spacing="{OnPlatform Android=20, iOS=24, MacCatalyst=28}">
            <!-- Projector icon -->
            <Image Source="projector.svg"
                   HeightRequest="{OnPlatform Android=100, iOS=110, MacCatalyst=130}"
                   WidthRequest="{OnPlatform Android=134, iOS=147, MacCatalyst=174}"
                   Aspect="AspectFit"
                   HorizontalOptions="Center" />

            <!-- Pulsing neon border around logo -->
            <Border x:Name="GlowBorder"
                    Stroke="#C8A0FF"
                    StrokeThickness="{OnPlatform Android=2.5, iOS=2.5, MacCatalyst=3}"
                    StrokeShape="RoundRectangle 14"
                    BackgroundColor="Transparent"
                    Padding="{OnPlatform Android=6, iOS=8, MacCatalyst=10}"
                    HorizontalOptions="Center"
                    Opacity="0.7">
                <Border.Shadow>
                    <Shadow Brush="#C8A0FF" Offset="0,0" Radius="25" Opacity="0.9" />
                </Border.Shadow>

                <!-- Film strip logo -->
                <Border BackgroundColor="#111111"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 6"
                        Padding="0"
                        HorizontalOptions="Center">
                    <Border.Shadow>
                        <Shadow Brush="#B266FF" Offset="0,0" Radius="20" Opacity="0.7" />
                    </Border.Shadow>
                    <Grid RowDefinitions="Auto,Auto,Auto">
                        <HorizontalStackLayout Grid.Row="0" Spacing="{OnPlatform Android=8, iOS=8, MacCatalyst=10}" Padding="{OnPlatform Android='10,4,10,0', iOS='12,5,12,0', MacCatalyst='14,6,14,0'}" HorizontalOptions="Fill">
                            <BoxView Color="#333" WidthRequest="{OnPlatform Android=8, iOS=8, MacCatalyst=10}" HeightRequest="{OnPlatform Android=7, iOS=7, MacCatalyst=9}" CornerRadius="2" />
                            <BoxView Color="#333" WidthRequest="{OnPlatform Android=8, iOS=8, MacCatalyst=10}" HeightRequest="{OnPlatform Android=7, iOS=7, MacCatalyst=9}" CornerRadius="2" />
                            <BoxView Color="#333" WidthRequest="{OnPlatform Android=8, iOS=8, MacCatalyst=10}" HeightRequest="{OnPlatform Android=7, iOS=7, MacCatalyst=9}" CornerRadius="2" />
                            <BoxView Color="#333" WidthRequest="{OnPlatform Android=8, iOS=8, MacCatalyst=10}" HeightRequest="{OnPlatform Android=7, iOS=7, MacCatalyst=9}" CornerRadius="2" />
                            <BoxView Color="#333" WidthRequest="{OnPlatform Android=8, iOS=8, MacCatalyst=10}" HeightRequest="{OnPlatform Android=7, iOS=7, MacCatalyst=9}" CornerRadius="2" />
                            <BoxView Color="#333" WidthRequest="{OnPlatform Android=8, iOS=8, MacCatalyst=10}" HeightRequest="{OnPlatform Android=7, iOS=7, MacCatalyst=9}" CornerRadius="2" />
                            <BoxView Color="#333" WidthRequest="{OnPlatform Android=8, iOS=8, MacCatalyst=10}" HeightRequest="{OnPlatform Android=7, iOS=7, MacCatalyst=9}" CornerRadius="2" />
                            <BoxView Color="#333" WidthRequest="{OnPlatform Android=8, iOS=8, MacCatalyst=10}" HeightRequest="{OnPlatform Android=7, iOS=7, MacCatalyst=9}" CornerRadius="2" />
                            <BoxView Color="#333" WidthRequest="{OnPlatform Android=8, iOS=8, MacCatalyst=10}" HeightRequest="{OnPlatform Android=7, iOS=7, MacCatalyst=9}" CornerRadius="2" />
                            <BoxView Color="#333" WidthRequest="{OnPlatform Android=8, iOS=8, MacCatalyst=10}" HeightRequest="{OnPlatform Android=7, iOS=7, MacCatalyst=9}" CornerRadius="2" />
                            <BoxView Color="#333" WidthRequest="{OnPlatform Android=8, iOS=8, MacCatalyst=10}" HeightRequest="{OnPlatform Android=7, iOS=7, MacCatalyst=9}" CornerRadius="2" />
                            <BoxView Color="#333" WidthRequest="{OnPlatform Android=8, iOS=8, MacCatalyst=10}" HeightRequest="{OnPlatform Android=7, iOS=7, MacCatalyst=9}" CornerRadius="2" />
                            <BoxView Color="#333" WidthRequest="{OnPlatform Android=8, iOS=8, MacCatalyst=10}" HeightRequest="{OnPlatform Android=7, iOS=7, MacCatalyst=9}" CornerRadius="2" />
                            <BoxView Color="#333" WidthRequest="{OnPlatform Android=8, iOS=8, MacCatalyst=10}" HeightRequest="{OnPlatform Android=7, iOS=7, MacCatalyst=9}" CornerRadius="2" />
                            <BoxView Color="#333" WidthRequest="{OnPlatform Android=8, iOS=8, MacCatalyst=10}" HeightRequest="{OnPlatform Android=7, iOS=7, MacCatalyst=9}" CornerRadius="2" />
                            <BoxView Color="#333" WidthRequest="{OnPlatform Android=8, iOS=8, MacCatalyst=10}" HeightRequest="{OnPlatform Android=7, iOS=7, MacCatalyst=9}" CornerRadius="2" />
                            <BoxView Color="#333" WidthRequest="{OnPlatform Android=8, iOS=8, MacCatalyst=10}" HeightRequest="{OnPlatform Android=7, iOS=7, MacCatalyst=9}" CornerRadius="2" />
                            <BoxView Color="#333" WidthRequest="{OnPlatform Android=8, iOS=8, MacCatalyst=10}" HeightRequest="{OnPlatform Android=7, iOS=7, MacCatalyst=9}" CornerRadius="2" />
                            <BoxView Color="#333" WidthRequest="{OnPlatform Android=8, iOS=8, MacCatalyst=10}" HeightRequest="{OnPlatform Android=7, iOS=7, MacCatalyst=9}" CornerRadius="2" />
                            <BoxView Color="#333" WidthRequest="{OnPlatform Android=8, iOS=8, MacCatalyst=10}" HeightRequest="{OnPlatform Android=7, iOS=7, MacCatalyst=9}" CornerRadius="2" />
                        </HorizontalStackLayout>
                        <Label Grid.Row="1"
                               Text="■▷ C I N E M A  S H E L F"
                               TextColor="#E0AAFF"
                               FontSize="{OnPlatform Android=20, iOS=22, MacCatalyst=26}"
                               FontAttributes="Bold,Italic"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"
                               CharacterSpacing="2"
                               LineBreakMode="NoWrap"
                               Padding="{OnPlatform Android='12,6', iOS='14,8', MacCatalyst='18,10'}">
                            <Label.Shadow>
                                <Shadow Brush="#B266FF" Offset="0,0" Radius="15" Opacity="0.8" />
                            </Label.Shadow>
                        </Label>
                        <HorizontalStackLayout Grid.Row="2" Spacing="{OnPlatform Android=8, iOS=8, MacCatalyst=10}" Padding="{OnPlatform Android='10,0,10,4', iOS='12,0,12,5', MacCatalyst='14,0,14,6'}" HorizontalOptions="Fill">
                            <BoxView Color="#333" WidthRequest="{OnPlatform Android=8, iOS=8, MacCatalyst=10}" HeightRequest="{OnPlatform Android=7, iOS=7, MacCatalyst=9}" CornerRadius="2" />
                            <BoxView Color="#333" WidthRequest="{OnPlatform Android=8, iOS=8, MacCatalyst=10}" HeightRequest="{OnPlatform Android=7, iOS=7, MacCatalyst=9}" CornerRadius="2" />
                            <BoxView Color="#333" WidthRequest="{OnPlatform Android=8, iOS=8, MacCatalyst=10}" HeightRequest="{OnPlatform Android=7, iOS=7, MacCatalyst=9}" CornerRadius="2" />
                            <BoxView Color="#333" WidthRequest="{OnPlatform Android=8, iOS=8, MacCatalyst=10}" HeightRequest="{OnPlatform Android=7, iOS=7, MacCatalyst=9}" CornerRadius="2" />
                            <BoxView Color="#333" WidthRequest="{OnPlatform Android=8, iOS=8, MacCatalyst=10}" HeightRequest="{OnPlatform Android=7, iOS=7, MacCatalyst=9}" CornerRadius="2" />
                            <BoxView Color="#333" WidthRequest="{OnPlatform Android=8, iOS=8, MacCatalyst=10}" HeightRequest="{OnPlatform Android=7, iOS=7, MacCatalyst=9}" CornerRadius="2" />
                            <BoxView Color="#333" WidthRequest="{OnPlatform Android=8, iOS=8, MacCatalyst=10}" HeightRequest="{OnPlatform Android=7, iOS=7, MacCatalyst=9}" CornerRadius="2" />
                            <BoxView Color="#333" WidthRequest="{OnPlatform Android=8, iOS=8, MacCatalyst=10}" HeightRequest="{OnPlatform Android=7, iOS=7, MacCatalyst=9}" CornerRadius="2" />
                            <BoxView Color="#333" WidthRequest="{OnPlatform Android=8, iOS=8, MacCatalyst=10}" HeightRequest="{OnPlatform Android=7, iOS=7, MacCatalyst=9}" CornerRadius="2" />
                            <BoxView Color="#333" WidthRequest="{OnPlatform Android=8, iOS=8, MacCatalyst=10}" HeightRequest="{OnPlatform Android=7, iOS=7, MacCatalyst=9}" CornerRadius="2" />
                            <BoxView Color="#333" WidthRequest="{OnPlatform Android=8, iOS=8, MacCatalyst=10}" HeightRequest="{OnPlatform Android=7, iOS=7, MacCatalyst=9}" CornerRadius="2" />
                            <BoxView Color="#333" WidthRequest="{OnPlatform Android=8, iOS=8, MacCatalyst=10}" HeightRequest="{OnPlatform Android=7, iOS=7, MacCatalyst=9}" CornerRadius="2" />
                            <BoxView Color="#333" WidthRequest="{OnPlatform Android=8, iOS=8, MacCatalyst=10}" HeightRequest="{OnPlatform Android=7, iOS=7, MacCatalyst=9}" CornerRadius="2" />
                            <BoxView Color="#333" WidthRequest="{OnPlatform Android=8, iOS=8, MacCatalyst=10}" HeightRequest="{OnPlatform Android=7, iOS=7, MacCatalyst=9}" CornerRadius="2" />
                            <BoxView Color="#333" WidthRequest="{OnPlatform Android=8, iOS=8, MacCatalyst=10}" HeightRequest="{OnPlatform Android=7, iOS=7, MacCatalyst=9}" CornerRadius="2" />
                            <BoxView Color="#333" WidthRequest="{OnPlatform Android=8, iOS=8, MacCatalyst=10}" HeightRequest="{OnPlatform Android=7, iOS=7, MacCatalyst=9}" CornerRadius="2" />
                            <BoxView Color="#333" WidthRequest="{OnPlatform Android=8, iOS=8, MacCatalyst=10}" HeightRequest="{OnPlatform Android=7, iOS=7, MacCatalyst=9}" CornerRadius="2" />
                            <BoxView Color="#333" WidthRequest="{OnPlatform Android=8, iOS=8, MacCatalyst=10}" HeightRequest="{OnPlatform Android=7, iOS=7, MacCatalyst=9}" CornerRadius="2" />
                            <BoxView Color="#333" WidthRequest="{OnPlatform Android=8, iOS=8, MacCatalyst=10}" HeightRequest="{OnPlatform Android=7, iOS=7, MacCatalyst=9}" CornerRadius="2" />
                            <BoxView Color="#333" WidthRequest="{OnPlatform Android=8, iOS=8, MacCatalyst=10}" HeightRequest="{OnPlatform Android=7, iOS=7, MacCatalyst=9}" CornerRadius="2" />
                        </HorizontalStackLayout>
                    </Grid>
                </Border>
            </Border>

            <!-- Subtitle -->
            <Label Text="Your movie &amp; series collection"
                   TextColor="#9977BB"
                   FontSize="{OnPlatform Android=14, iOS=15, MacCatalyst=18}"
                   FontAttributes="Italic"
                   HorizontalOptions="Center"
                   Margin="0,10,0,0" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>
